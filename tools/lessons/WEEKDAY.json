  "descEn": "Returns a number for the day of the week of a date — great for telling weekdays from weekends.",
  "syntax": "=WEEKDAY(serial_number, [return_type])",
  "keywords": ["星期幾", "週末判斷", "平日假日", "日期", "排班"],
