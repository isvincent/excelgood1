  "descEn": "Multiplies corresponding items in ranges and returns the sum; also handy for conditional sums and counts.",
  "syntax": "=SUMPRODUCT(array1, [array2], [array3], …)",
  "keywords": ["相乘加總", "總金額", "條件加總", "多條件計數", "陣列"],
  "level": 2,
