        ["李美華", "302", "92", "", ""],
        ["陳志強", "301", "75", "", ""],
        ["林雅婷", "303", "95", "", ""],
        ["張家豪", "302", "81", "", ""],
        ["黃怡君", "301", "90", "", ""]
