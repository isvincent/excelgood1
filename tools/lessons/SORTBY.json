  "descEn": "Sorts a range based on the values in another range, with as many sort keys as you need.",
  "syntax": "=SORTBY(array, by_array1, [sort_order1], [by_array2, sort_order2], …)",
  "keywords": ["排序", "依欄排序", "多條件排序", "排名", "名次"],
  "level": 2,
  "version": "Microsoft 365 / Excel 2021 以上",
  "slides": [
    {
      "type": "title",
